# NEXT_PUBLIC_API_URL must include /api for REST calls (Socket.IO strips it automatically).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Optional — Sentry error reporting (client + server instrumentation).
# NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_DISABLED="true"

# Optional — announcements feature diagnostics panel and "new" badge window (days).
# NEXT_PUBLIC_ANNOUNCEMENT_DIAGNOSTIC="true"
# NEXT_PUBLIC_ANNOUNCEMENT_NEW_DAYS=7
