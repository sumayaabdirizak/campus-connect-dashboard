# ── Backend environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env (it is git-ignored).

# ── Required ─────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/campus_connect?schema=public"
# Secret used to sign auth + refresh tokens (also secures the Socket.IO handshake).
# Generate a strong value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-secret"

# ── Optional ─────────────────────────────────────────────────────────
# API port (default 4000)
PORT=4000

# Seeded super-admin account (used by `npm run prisma:seed`)
SUPER_ADMIN_EMAIL="admin@example.edu"
SUPER_ADMIN_NAME="Super Admin"

# Set to 1 for a lightweight dev seed (one faculty, one batch/section, one teacher/student).
# SEED_MINIMAL=1

# AI quiz-question generation (free key: https://console.groq.com/keys)
AI_PROVIDER="groq"
GROQ_API_KEY=""

# Web-push notifications (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.edu"

# Dedicated signing secrets (optional — fall back to JWT_SECRET if unset).
# Set these in production so signing keys aren't reused across concerns.
# QR_TOKEN_SECRET=""
# DISCUSSION_ATTACHMENT_SIGNING_SECRET=""
# ANNOUNCEMENT_LINK_REDIRECT_SECRET=""

# CORS / frontend origin(s) — comma-separated. Defaults to localhost in dev.
# CORS_ORIGINS="http://localhost:3000"
# SOCKET_CORS="http://localhost:3000"
# FRONTEND_URL="http://localhost:3000"

# Optional Redis (Socket.IO adapter, BullMQ workers)
# REDIS_URL="redis://localhost:6379"
