generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProgramLevel {
  UNDERGRADUATE
  POSTGRADUATE
}

enum DiscussionScopeType {
  FACULTY
  DEPARTMENT
  BATCH
  SECTION
  /// Used by USER_SERVER (clubs). `scopeId` references Club.id so each club
  /// gets its own (scopeType, scopeId) row without colliding with the
  /// faculty/department/batch/section hierarchy.
  CLUB
}

enum DiscussionMembershipRole {
  STUDENT
  LECTURER
  HEAD
  DEAN
  ADMIN
  ADVISOR
}

enum DiscussionMessageType {
  TEXT
  MEDIA
  SYSTEM
  QUESTION
}

enum DiscussionAttachmentType {
  IMAGE
  VIDEO
  FILE
}

enum DiscussionNotificationType {
  MESSAGE
  MENTION
  ADMIN_ANNOUNCEMENT
  THREAD
  REACTION
  PIN
  CLUB_APPROVED
  CLUB_REJECTED
  CLUB_JOIN_REQUEST
  CLUB_JOIN_DECIDED
  CLUB_INVITE
  CLUB_PROMOTED
  CLUB_REMOVED
}

/// Lifecycle for a Club row. PENDING clubs have no DiscussionGroup yet (Path A).
/// APPROVED clubs are live. SUSPENDED freezes chat; ARCHIVED hides from sidebar.
enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

/// How a non-member can join a club.
enum ClubJoinPolicy {
  OPEN
  BY_REQUEST
  INVITE_ONLY
}

/// Scope of who can see a club in discovery.
enum ClubScopeKind {
  FACULTY
  UNIVERSITY
  CROSS
}

/// State of a ClubJoinRequest row.
enum ClubJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// State of a ClubInvite token / direct invite.
enum ClubInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Audit actions tracked on a club for the manage > Audit tab.
enum ClubModerationAction {
  CREATE
  APPROVE
  REJECT
  SUSPEND
  ARCHIVE
  EDIT
  TRANSFER
  PROMOTE
  DEMOTE
  REMOVE_MEMBER
  REVOKE_INVITE
}

enum DiscussionGroupStatus {
  ACTIVE
  ARCHIVED
}

/// Hybrid Discord layout: faculty row becomes FACULTY_SERVER; dept/batch/section rows become *_LEGACY and map to channels on that server.
enum DiscussionServerKind {
  SCOPE_GROUP
  FACULTY_SERVER
  USER_SERVER
  DEPARTMENT_LEGACY
  BATCH_LEGACY
  SECTION_LEGACY
}

enum DiscussionChannelKind {
  TEXT
  ANNOUNCEMENT
  FORUM
}

enum DiscussionOverwriteTarget {
  ROLE
  MEMBER
}

enum GroupDmMemberRole {
  OWNER
  MEMBER
}

enum GroupMemberRole {
  LEADER
  MEMBER
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  EXPIRED
  ARCHIVED
}

/// Primary broadcast scope (single hierarchy row on Announcement).
enum AnnouncementBroadcastScope {
  ALL
  FACULTY
  DEPARTMENT
  BATCH
  SECTION
}

/// Multi-target rows (AnnouncementTarget); mirrors faculty/dept/batch/section.
enum AnnouncementTargetScopeType {
  FACULTY
  DEPARTMENT
  BATCH
  SECTION
}

enum AnnouncementAttachmentKind {
  IMAGE
  VIDEO
  DOCUMENT
  LINK
}

/// Outcome of an announcement SMS attempt (audit trail). Retention: purge per institutional policy (ops), not in-app TTL.
enum SmsAuditLogStatus {
  SKIPPED
  SENT
  FAILED
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  users User[]
}

/// Deny-list for JWT IDs (jti) revoked before their natural expiry. Every
/// access + refresh token is issued with a UUID jti; on logout (and on
/// refresh-token rotation) the old jti is inserted here. The auth
/// middleware checks this table after `jwt.verify` succeeds — if the jti
/// is present, the token is treated as if it had expired.
///
/// `expiresAt` lets us clean the table up periodically without losing the
/// revocation guarantee — rows for tokens past their natural expiry are
/// safe to delete because the token would be rejected by `jwt.verify`
/// anyway. A small cron can run `DELETE WHERE expiresAt < NOW()` daily.
model RevokedToken {
  jti       String   @id
  /// User who owned the token. Stored for forensics + bulk-revoke ("nuke
  /// every active session for user X" becomes one query).
  userId    Int?
  /// Why the token was revoked. Useful for audit logs and for distinguishing
  /// "user logged out" from "admin force-revoked".
  reason    String?
  /// When the underlying JWT naturally expires — used by the cleanup cron.
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id                   Int           @id @default(autoincrement())
  full_name            String
  email                String        @unique
  number               String        @unique
  phone                String?
  password_hash        String
  status               AccountStatus @default(ACTIVE)
  must_change_password Boolean       @default(true)
  last_login_at        DateTime?
  created_at           DateTime      @default(now())
  updated_at           DateTime      @updatedAt

  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  studentProfile       StudentProfile?
  lecturerProfile      LecturerProfile?
  deanProfile          DeanProfile?
  facultyAdminProfile FacultyAdminProfile?

  batchesCreated  Batch[]   @relation("BatchCreator")
  batchesModified Batch[]   @relation("BatchModifier")
  facultiesAsDean Faculty[] @relation("FacultyDean")
  departmentsAsHead Department[] @relation("DepartmentHead")
  batchesAsAdvisor Batch[] @relation("BatchAdvisor")
  sectionsAsModerator BatchSection[] @relation("SectionModerator")

  studentRegistrations StudentRegistration[]
  teacherAssignings    TeacherAssigning[]
  resourcesUploads     Resource[]
  resourceViews        ResourceView[]
  announcementsWritten Announcement[]
  messagesSent         ChatMessage[]
  chatMentions         ChatMessageMention[]
  submissions          Submission[]
  quizAttempts         QuizAttempt[]
  teacherOfferings     CourseOffering[]      @relation("TeacherOfferings")
  announcementReads    AnnouncementRead[]
  announcementAudits   AnnouncementAudit[] @relation("AnnouncementAuditActor")
  createdCourseGroups  CourseGroup[]
  groupMemberships     GroupMember[]
  coursePostsAuthored  CoursePost[]
  coursePostReactions  CoursePostReaction[]
  coursePostRepliesAuthored CoursePostReply[]
  courseOfferingAccess CourseOfferingAccess[]
  submissionExtensionsReceived SubmissionExtension[] @relation("SubmissionExtensionStudent")
  submissionExtensionsGranted  SubmissionExtension[] @relation("SubmissionExtensionGranter")
  assignmentAttachmentsUploaded AssignmentAttachment[]
  discussionMemberships DiscussionGroupMembership[]
  discussionMessagesSent DiscussionMessage[]         @relation("DiscussionMessageSender")
  discussionReadReceipts DiscussionReadReceipt[]
  discussionNotifications DiscussionNotification[]
  discussionSessions DiscussionSession[]
  discussionMuteSettings DiscussionMuteSetting[]
  discussionMessageReactions DiscussionMessageReaction[]
  discussionPinnedMessages DiscussionPinnedMessage[] @relation("DiscussionPinnedBy")
  discussionAuditLogs     DiscussionAuditLog[]      @relation("DiscussionAuditLogActor")
  discussionAttachmentsUploaded DiscussionAttachment[]
  discussionDeviceKeys DiscussionDeviceKey[]
  discussionKeyEnvelopes DiscussionGroupKeyEnvelope[]
  discussionGroupsOwned DiscussionGroup[] @relation("DiscussionGroupOwner")
  groupDmsCreated       GroupDm[]         @relation("GroupDmCreator")
  groupDmMemberships    GroupDmMember[]

  clubsOwned            Club[]                 @relation("ClubOwner")
  clubJoinRequests      ClubJoinRequest[]      @relation("ClubJoinRequester")
  clubJoinDecisions     ClubJoinRequest[]      @relation("ClubJoinDecider")
  clubInvitesSent       ClubInvite[]           @relation("ClubInviteInviter")
  clubInvitesReceived   ClubInvite[]           @relation("ClubInviteInvitee")
  clubAuditActions      ClubModerationAudit[]  @relation("ClubAuditActor")
  clubDecisions         Club[]                 @relation("ClubDecidedBy")
  userInterests         UserInterest[]

  webPushSubscriptions WebPushSubscription[]
  announcementComments AnnouncementComment[]
  announcementReactions AnnouncementReaction[]
  announcementAcknowledgements AnnouncementAcknowledgement[]

  /// Custom line shown in discussions (e.g. "In class", "Do Not Disturb"). Distinct from account `status`.
  discussionCustomStatus String? @db.VarChar(80)

  /// Opt-in for SMS alerts on campus announcements (TCPA-style; default false for existing users).
  smsOptIn Boolean @default(false)

  smsAuditLogs SmsAuditLog[]

  /// Outbound link click events (CTR proxy). `userId` null for unsigned/anonymous opens — align retention with GDPR/FERPA policy.
  announcementLinkClicks AnnouncementLinkClick[]

  calendarEvents CalendarEvent[]
}

/// Personal calendar events / reminders created by a user. Distinct from
/// course deadlines (derived from announcements/assignments/quizzes): these are
/// user-owned and visible only to their creator. The calendar UI merges them
/// with deadlines for a unified view.
model CalendarEvent {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String  @db.VarChar(200)
  notes String? @db.Text
  /// Hex accent color for the event chip (e.g. "#0468CE"). UI falls back to a
  /// default when null.
  color String? @db.VarChar(9)

  startsAt DateTime
  endsAt   DateTime?
  allDay   Boolean   @default(false)

  /// When to remind the user. Storing intent only — delivery is a follow-up.
  reminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startsAt])
}

/// Nightly (or on-demand) rollup of hot announcement metrics for dashboards. One row per announcement per UTC calendar day (`snapshotAt` at midnight UTC).
model AnnouncementAnalyticsSnapshot {
  id                Int      @id @default(autoincrement())
  announcementId  Int
  snapshotAt        DateTime
  impressions       Int      @default(0)
  uniqueReaders     Int      @default(0)
  readRate          Float?
  likes             Int      @default(0)
  acknowledgedCount Int      @default(0)
  linkClicks        Int      @default(0)

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, snapshotAt])
  @@index([snapshotAt])
}

/// CTR proxy: one row per tracked redirect through `/api/r/...`. Retention: purge per institutional policy (GDPR).
model AnnouncementLinkClick {
  id             Int      @id @default(autoincrement())
  announcementId Int
  userId         Int?
  url            String   @db.Text
  clickedAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([announcementId, clickedAt])
  @@index([announcementId, userId])
}

enum CalendarReminderPhase {
  T24H
  T1H
}

/// One row per announcement per phase after a T-24h / T-1h reminder has been sent (dedupe). Reset when `deadlineAt` is edited.
model CalendarReminderJob {
  id             String               @id @default(cuid())
  announcementId Int
  phase          CalendarReminderPhase
  sentAt         DateTime?
  createdAt      DateTime             @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, phase])
  @@index([announcementId])
}

model StudentProfile {
  id             Int    @id @default(autoincrement())
  userId         Int    @unique
  student_number String @unique
  admission_year Int
  facultyId      Int
  departmentId   Int
  programId      Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LecturerProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  specialty    String?
  hire_date    DateTime @default(now())
  departmentId Int

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department        @relation(fields: [departmentId], references: [id])
  faculties   LecturerFaculty[]
}

model DeanProfile {
  id        Int @id @default(autoincrement())
  userId    Int @unique
  facultyId Int @unique

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id])
}

/// Many-to-many: a lecturer can be in many faculties
model LecturerFaculty {
  lecturerProfileId Int
  facultyId         Int

  lecturerProfile LecturerProfile @relation(fields: [lecturerProfileId], references: [id])
  faculty         Faculty         @relation(fields: [facultyId], references: [id])

  @@id([lecturerProfileId, facultyId])
  @@index([lecturerProfileId])
  @@index([facultyId])
}

model Department {
  id         Int      @id @default(autoincrement())
  name       String
  code       String   @unique
  facultyId  Int
  /// Optional department head (moderator in department discussion group).
  headUserId Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  faculty        Faculty           @relation(fields: [facultyId], references: [id])
  head           User?             @relation("DepartmentHead", fields: [headUserId], references: [id])
  programs       Program[]
  courses        Course[]
  announcements  Announcement[]
  lecturers      LecturerProfile[]

  @@index([headUserId])
}

model Faculty {
  id         Int      @id @default(autoincrement())
  name       String
  code       String   @unique
  deanId     Int?
  dean       User?    @relation("FacultyDean", fields: [deanId], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  departments           Department[]
  lecturerAffiliates     LecturerFaculty[]
  deanProfile             DeanProfile?
  facultyAdminProfiles    FacultyAdminProfile[]
  announcements         Announcement[]
  clubs                 Club[]
}

/// Faculty-scoped administrator (manages student/lecturer profiles within one faculty).
model FacultyAdminProfile {
  faculty_admin_id Int @id @default(autoincrement())
  user_id          Int @unique
  faculty_id       Int

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [faculty_id], references: [id])

  @@index([faculty_id])
}

model Program {
  id           Int          @id @default(autoincrement())
  name         String
  code         String       @unique
  level        ProgramLevel
  departmentId Int
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  batches    Batch[]
}

model AcademicYear {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  start_date DateTime
  end_date   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  semesters                       Semester[]
  batches                         Batch[]
  registrationsAsRegistrationYear StudentRegistration[] @relation("RegistrationYear")
  registrationsAsCurrentYear      StudentRegistration[] @relation("CurrentYear")
  courseOfferings                 CourseOffering[]
}

model Semester {
  id             Int          @id @default(autoincrement())
  name           String
  sequence       Int
  start_date     DateTime
  end_date       DateTime
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  registrations   StudentRegistration[]
  courseOfferings CourseOffering[]
}

model Batch {
  id              Int      @id @default(autoincrement())
  name            String
  academic_year   Int
  programId       Int
  academicYearId  Int
  semester_number Int      @default(1)
  /// Optional batch advisor (moderator alongside dean in batch discussion).
  advisorUserId   Int?
  created_by_id   Int?
  modified_by_id  Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  program       Program       @relation(fields: [programId], references: [id])
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id])
  createdBy     User?         @relation("BatchCreator", fields: [created_by_id], references: [id])
  modifiedBy    User?        @relation("BatchModifier", fields: [modified_by_id], references: [id])
  advisor       User?         @relation("BatchAdvisor", fields: [advisorUserId], references: [id])

  sections       BatchSection[] @relation("BatchToBatchSection")
  announcements  Announcement[]

  @@index([advisorUserId])
}

model BatchSection {
  id         Int      @id @default(autoincrement())
  name       String
  batchId    Int
  /// Primary section lecturer/moderator (moderator in section discussion when set).
  moderatorUserId Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  batch                Batch                 @relation(fields: [batchId], references: [id], name: "BatchToBatchSection")
  moderator            User?                 @relation("SectionModerator", fields: [moderatorUserId], references: [id])
  studentRegistrations StudentRegistration[]
  courseOfferings      CourseOffering[]
  announcements        Announcement[]

  @@unique([batchId, name])
  @@index([batchId])
  @@index([moderatorUserId])
}

model StudentRegistration {
  id                         Int @id @default(autoincrement())
  studentId                  Int
  batchSectionId             Int
  registrationAcademicYearId Int
  currentAcademicYearId      Int
  currentSemesterId          Int

  student                  User         @relation(fields: [studentId], references: [id])
  batchSection             BatchSection @relation(fields: [batchSectionId], references: [id])
  registrationAcademicYear AcademicYear @relation("RegistrationYear", fields: [registrationAcademicYearId], references: [id])
  currentAcademicYear      AcademicYear @relation("CurrentYear", fields: [currentAcademicYearId], references: [id])
  currentSemester          Semester     @relation(fields: [currentSemesterId], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// ─── COURSE SYSTEM ────────────────────────────────────────────────────────────

/// A course belongs to a department (e.g. "Algorithms", "Math 101")
model Course {
  id           Int      @id @default(autoincrement())
  name         String
  code         String   @unique
  description  String?
  credits      Int      @default(3)
  departmentId Int
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  thumbnail    String?

  department        Department         @relation(fields: [departmentId], references: [id])
  teacherAssignings TeacherAssigning[]
  offerings         CourseOffering[]
  resources         Resource[]
}

/// Assigns a teacher to a course (Teacher ↔ Course, not Section)
model TeacherAssigning {
  id          Int      @id @default(autoincrement())
  teacherId   Int
  courseId    Int
  assigned_at DateTime @default(now())

  teacher User   @relation(fields: [teacherId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([teacherId, courseId])
  @@index([teacherId])
  @@index([courseId])
}

/// A course is "offered" to a specific section + semester + academic year
model CourseOffering {
  id             Int      @id @default(autoincrement())
  /// External identifier for URLs and API paths (never expose numeric id to clients).
  publicId       String   @unique @default(uuid()) @db.Uuid
  courseId       Int
  sectionId      Int
  semesterId     Int
  academicYearId Int
  teacherId      Int?
  created_at     DateTime @default(now())

  course       Course       @relation(fields: [courseId], references: [id])
  section      BatchSection @relation(fields: [sectionId], references: [id])
  semester     Semester     @relation(fields: [semesterId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  teacher      User?        @relation("TeacherOfferings", fields: [teacherId], references: [id])

  assignments Assignment[]
  quizzes     Quiz[]
  chatRooms      ChatRoom[]
  courseGroups   CourseGroup[]
  groupMembers   GroupMember[]
  coursePosts    CoursePost[]
  accesses       CourseOfferingAccess[]
  resources      Resource[]
  modules        CourseModule[]
  bankQuestions  Question[]

  @@unique([courseId, sectionId, semesterId, academicYearId])
  @@index([courseId])
  @@index([sectionId])
  @@index([semesterId])
}

/// How the work is produced for this assignment.
enum AssignmentWorkMode {
  INDIVIDUAL
  GROUP
}

/// Where the grade lives. INDIVIDUAL means each student is graded separately
/// (even on a GROUP submission — e.g. participation marks). GROUP means a
/// single grade is shared across every member via fan-out.
enum AssignmentGradingScope {
  INDIVIDUAL
  GROUP
}

model Assignment {
  id               Int       @id @default(autoincrement())
  title            String
  description      String?
  /// When students may start submitting. Null = open immediately.
  open_at          DateTime?
  due_date         DateTime
  courseOfferingId Int
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  is_draft         Boolean   @default(false)

  workMode           AssignmentWorkMode     @default(INDIVIDUAL)
  gradingScope       AssignmentGradingScope @default(INDIVIDUAL)
  /// Grace window after `due_date` during which submissions are still accepted
  /// (recorded with is_late=true). Zero disables the grace window.
  lateWindowMinutes  Int                    @default(0)
  /// Total marks for this assignment. Grades are validated 0..maxMarks.
  /// Default 100 preserves the existing percentage-based grading behaviour.
  maxMarks           Int                    @default(100)

  courseOffering CourseOffering        @relation(fields: [courseOfferingId], references: [id])
  submissions    Submission[]
  extensions     SubmissionExtension[]
  attachments    AssignmentAttachment[]
}

/// Files a teacher attaches when creating/editing an assignment (spec PDF,
/// rubric, dataset, etc.). Stored locally under /uploads/assignments and
/// served via the express.static mount at `/uploads`.
model AssignmentAttachment {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  name         String
  url          String
  size         Int?
  mimeType     String?
  uploadedById Int
  created_at   DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([assignmentId])
}

model Submission {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  studentId    Int
  /// Set when this submission was made as part of a group (gradingMode=GROUP).
  /// All members of `groupId` share the same grade/feedback via fan-out.
  groupId      Int?
  content_url  String
  submitted_at DateTime @default(now())
  grade        Float?
  feedback     String?
  is_reviewed  Boolean  @default(false)
  is_late      Boolean  @default(false)

  assignment Assignment   @relation(fields: [assignmentId], references: [id])
  student    User         @relation(fields: [studentId], references: [id])
  group      CourseGroup? @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

/// Per-assignment deadline extension. Either `studentId` OR `groupId` is set,
/// depending on the assignment's gradingMode. `newDueAt` overrides
/// Assignment.due_date for that target.
model SubmissionExtension {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  studentId    Int?
  groupId      Int?
  newDueAt     DateTime
  reason       String?
  grantedById  Int
  created_at   DateTime @default(now())

  assignment Assignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User?        @relation("SubmissionExtensionStudent", fields: [studentId], references: [id])
  group      CourseGroup? @relation(fields: [groupId], references: [id])
  grantedBy  User         @relation("SubmissionExtensionGranter", fields: [grantedById], references: [id])

  @@unique([assignmentId, studentId])
  @@unique([assignmentId, groupId])
  @@index([assignmentId])
}

model Quiz {
  id               Int      @id @default(autoincrement())
  title            String
  description     String?
  duration_minutes Int
  courseOfferingId Int
  open_at          DateTime?
  close_at         DateTime?
  is_draft         Boolean  @default(false)
  shuffle_questions Boolean  @default(false)
  shuffle_answers  Boolean  @default(false)
  max_attempts     Int       @default(1)
  passing_score    Float     @default(50)
  created_at       DateTime  @default(now())

  // Timing modes: flexible (default) or fixed
  timing_mode        String   @default("flexible") // "flexible" | "fixed"
  scheduled_duration Int?                     // Duration for planning (fixed mode)

  /// Confidence-based scoring (Cologne / Bristol style). When enabled the
  /// student tags every objective answer with a confidence level (LOW / MED
  /// / HIGH); scoring then rewards calibrated thinking and penalises
  /// confidently-wrong answers. Off by default — teachers opt in per quiz.
  /// See `scoreAnswer` in services/quizAttempt.service.js for the formula.
  confidence_scoring Boolean   @default(false)

  /// Optional chapter / unit bucket. Re-uses the same CourseModule rows
  /// resources are grouped under so a "Week 1" module shows its quiz and
  /// its readings in the same place. `null` = Ungrouped.
  moduleId         Int?

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id])
  module         CourseModule?  @relation(fields: [moduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  questions      QuizQuestion[]
  attempts       QuizAttempt[]

  @@index([moduleId])
}

model QuizOption {
  id           Int     @id @default(autoincrement())
  questionId   Int
  option_text String
  is_correct  Boolean @default(false)
  order_index Int    @default(0)

  // Cascade deletes so removing a question wipes its options atomically
  // (was a manual loop in the controller — see Step 1 of the quiz audit).
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model QuizQuestion {
  id              Int      @id @default(autoincrement())
  quizId          Int
  question_text  String
  question_type  QuestionType @default(MCQ)
  points          Float    @default(1)
  correct_answer String?
  order_index    Int      @default(0)
  /// Optional teacher-authored explanation shown to the student on the
  /// review screen after submitting. Lets the question teach even when the
  /// student got it wrong ("Big-O of quicksort is O(n²) in the worst case
  /// when the pivot is always the smallest / largest element …").
  explanation    String?

  // Cascade: deleting a quiz drops all its questions (and via QuizOption's
  // own cascade, all option rows too).
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options QuizOption[]
  answers QuizAnswer[]
}

// ─── QUESTION BANK (Reusable Questions) ──────────────────────────────────────────

/// Bank question — a reusable question definition the teacher can drop into
/// any quiz on the same offering. Distinct from `QuizQuestion` (which is the
/// instance baked into a single quiz). Importing into a quiz copies the
/// text + options into a fresh `QuizQuestion` row so later edits to the
/// bank don't silently mutate already-published quizzes.
model Question {
  id             Int          @id @default(autoincrement())
  question_text  String
  question_type QuestionType @default(MCQ)
  points         Float        @default(1)
  /// Legacy free-text course label. New rows MUST set `courseOfferingId`
  /// instead — `course_code` is kept only so we can finish migrating any
  /// pre-Step-12 bank rows without dropping them on the floor.
  course_code    String?
  topic         String?      // e.g., "Sorting", "Big-O"
  difficulty    String?      // "easy", "medium", "hard"
  is_active     Boolean     @default(true)
  created_at    DateTime    @default(now())
  created_by    Int?        // Teacher ID

  /// Scope. Nullable for migration safety; the controller refuses to serve
  /// or write rows with `courseOfferingId IS NULL`. Cascade-deletes wipe
  /// bank rows when an offering is deleted.
  courseOfferingId Int?
  /// Optional chapter / module link (re-uses the CourseModule rows that
  /// group resources + quizzes). `null` = bank-wide, not pinned to a unit.
  moduleId         Int?

  courseOffering CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  module         CourseModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bankOptions    QuestionOptionBank[]

  @@index([courseOfferingId, moduleId, is_active])
}

model QuestionOptionBank {
  id           Int     @id @default(autoincrement())
  questionId   Int
  option_text String
  is_correct  Boolean @default(false)
  order_index Int    @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model QuizAttempt {
  id           Int       @id @default(autoincrement())
  quizId       Int
  studentId   Int
  started_at  DateTime  @default(now())
  // Server-authoritative auto-submit time. Stamped at start = started_at +
  // duration. The background job scans for `submitted_at IS NULL AND
  // expires_at <= now()` so a tab-close, network drop, or browser crash can't
  // lose the student's progress. Nullable for backwards compatibility with
  // legacy attempts created before this column existed.
  expires_at  DateTime?
  submitted_at DateTime?
  score       Float?
  grade       Float?
  is_graded   Boolean   @default(false)

  // Anti-cheating fields
  closure_reason    String?   // null | "violations" | "time_expired" | "student_exit"
  violations_count Int   @default(0)
  warnings_shown   Int   @default(0)

  @@index([expires_at])

  // Cascade: deleting a quiz drops attempts (and via QuizAnswer cascade,
  // every answer row attached to those attempts).
  quiz    Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student User @relation(fields: [studentId], references: [id])
  answers QuizAnswer[]
}

model QuizAnswer {
  id             Int     @id @default(autoincrement())
  attemptId      Int
  questionId    Int
  question_type String
  selected_option_id Int?
  text_answer   String?
  is_correct   Boolean?
  points_earned Float?
  /// Student-declared confidence for confidence-scored quizzes. Null on
  /// quizzes that don't use confidence scoring AND on short-answer rows
  /// (confidence only applies to objective answers the system can score).
  /// Persisted as the bare string ('LOW' | 'MED' | 'HIGH') so future
  /// values don't require an enum migration; the scoring function
  /// validates and falls back to MED on unknown values.
  confidence    String?

  attempt   QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  // If a teacher deletes a question after attempts exist, the answer rows go
  // too — we lose audit fidelity but avoid orphan answers that crash the UI.
  question  QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}


enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResourceType {
  SYLLABUS
  ASSIGNMENT
  LECTURE_NOTE
  VIDEO
  /// Browser-recorded or uploaded audio clip (voice notes, lecture recordings).
  AUDIO
  EXTERNAL_LINK
  OTHER
}

model Resource {
  id           Int            @id @default(autoincrement())
  title        String
  description  String?
  type         ResourceType
  url          String
  /// Original filename the teacher uploaded (for force-download Content-Disposition).
  /// Null for URL-only resources (videos, external links).
  originalName String?
  /// Mime-type recorded at upload time; lets the UI pick the right renderer
  /// (PDF preview vs. generic download) without sniffing the URL.
  mimeType     String?
  status       ResourceStatus @default(PENDING)
  /// Legacy scope at the Course level — kept for backward compat. New code
  /// should rely on `courseOfferingId` which scopes per-section / per-semester.
  courseId     Int
  /// Per-offering scope. Filled on create going forward; existing rows are
  /// backfilled by the migration where possible.
  courseOfferingId Int?
  /// Optional grouping within a course module (Week 1, Module 2, etc.).
  /// Null = "Ungrouped" bucket at the bottom of the page.
  moduleId     Int?
  /// Drag-reorder index. Lower values render first within their module.
  position     Int            @default(0)
  teacherId    Int
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  is_draft     Boolean        @default(false)

  course         Course          @relation(fields: [courseId], references: [id])
  teacher        User            @relation(fields: [teacherId], references: [id])
  courseOffering CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  module         CourseModule?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  views          ResourceView[]

  @@index([courseOfferingId])
  @@index([moduleId, position])
}

/// Per-student watch record for a video/audio resource. One row per
/// (resource, student) — upserted as the student watches. `watchedSeconds`
/// accumulates unique playback time (we add the wall-clock delta between
/// heartbeats only while the media is playing, so seeking ahead doesn't
/// inflate it). `durationSeconds` is the media length reported by the
/// player; completion is derived as watchedSeconds / durationSeconds.
model ResourceView {
  id                  Int      @id @default(autoincrement())
  resourceId          Int
  studentId           Int
  /// Accumulated seconds of actual playback (monotonic — never decreases).
  watchedSeconds      Int      @default(0)
  /// Media duration in seconds as reported by the player (0 until known).
  durationSeconds     Int      @default(0)
  /// Last playback position — lets the player resume where the student left off.
  lastPositionSeconds Int      @default(0)
  /// Flipped true once watched/duration crosses the completion threshold (~0.9).
  completed           Boolean  @default(false)
  /// Number of distinct play sessions (incremented when playback starts from ~0).
  viewCount           Int      @default(0)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([resourceId, studentId])
  @@index([resourceId])
}

/// Teacher-curated grouping for course resources (Week 1, Module 2, etc.).
/// Resources can be attached to a module via `Resource.moduleId`. Modules
/// themselves are ordered by `position`.
model CourseModule {
  id               Int       @id @default(autoincrement())
  courseOfferingId Int
  title            String
  description      String?
  position         Int       @default(0)
  /// Null = draft (only the teacher sees it). Set to a timestamp to publish.
  publishedAt      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  resources      Resource[]
  quizzes        Quiz[]
  bankQuestions  Question[]

  @@index([courseOfferingId, position])
}

/// priority: "normal" | "important" | "urgent"
/// targetType: "ALL" | "FACULTY" | "DEPARTMENT" | "BATCH" | "SECTION"
/// Hierarchy FKs are Int to match Faculty/Department/Batch/BatchSection ids.
model Announcement {
  id         Int    @id @default(autoincrement())
  title      String
  content    String @db.Text

  priority   AnnouncementPriority       @default(NORMAL)
  targetType AnnouncementBroadcastScope @default(ALL)
  status     AnnouncementStatus         @default(PUBLISHED)

  facultyId    Int?
  departmentId Int?
  batchId      Int?
  sectionId    Int?

  bodyMarkdown String? @db.Text
  bodyHtml     String? @db.Text
  expiresAt    DateTime?
  /// Optional calendar deadline (e.g. exam submission) shown on dashboard calendar.
  deadlineAt   DateTime?
  version      Int      @default(1)
  slug         String?  @unique
  acknowledgementRequired Boolean @default(false)
  commentsEnabled        Boolean @default(false)

  imageUrls   String[]
  targetRoles String[] @default([])
  isPinned    Boolean  @default(false)
  isActive    Boolean  @default(true)
  publishedAt DateTime?

  faculty    Faculty?       @relation(fields: [facultyId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  batch      Batch?         @relation(fields: [batchId], references: [id])
  section    BatchSection?  @relation(fields: [sectionId], references: [id])

  createdById   Int
  createdByRole String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reads       AnnouncementRead[]
  targets     AnnouncementTarget[]
  attachments AnnouncementAttachment[]
  audits      AnnouncementAudit[]
  comments    AnnouncementComment[]
  reactions   AnnouncementReaction[]
  acknowledgements AnnouncementAcknowledgement[]
  smsAuditLogs       SmsAuditLog[]
  analyticsSnapshots AnnouncementAnalyticsSnapshot[]
  linkClicks         AnnouncementLinkClick[]
  calendarReminderJobs CalendarReminderJob[]

  /// Full-text search (maintained by SQL trigger; optional until migration applied).
  searchVector Unsupported("tsvector")?

  @@index([facultyId])
  @@index([departmentId])
  @@index([batchId])
  @@index([sectionId])
  @@index([targetType])
  @@index([isActive])
  @@index([publishedAt])
  @@index([status])
}

model AnnouncementTarget {
  id             Int                        @id @default(autoincrement())
  announcementId Int
  scopeType      AnnouncementTargetScopeType
  scopeId        Int

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, scopeType, scopeId])
  @@index([scopeType, scopeId])
  @@index([announcementId])
}

model AnnouncementAttachment {
  id             Int                      @id @default(autoincrement())
  announcementId Int
  kind           AnnouncementAttachmentKind
  url            String
  mimeType       String?
  size           BigInt?
  thumbnailUrl   String?
  storageKey     String?
  virusScanStatus String? @default("PENDING")
  // WCAG 1.1.1 Non-text Content: short description for screen readers.
  altText        String?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
}

model AnnouncementAudit {
  id             String   @id @default(cuid())
  announcementId Int
  // Nullable so user erasure (GDPR Art. 17) can null this without dropping the row.
  actorId        Int?
  // Hashed actor identifier preserved for integrity even after erasure.
  actorIdHash    String?
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime @default(now())
  // Retention horizon (FERPA student-record default 7 years). Nightly purge job removes expired rows.
  expiresAt      DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AnnouncementAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([announcementId])
  @@index([actorId])
  @@index([createdAt])
  @@index([expiresAt])
}

/// `announcementId` / `userId` are Int to match `Announcement.id` and `User.id` (FK types must match PKs).
model AnnouncementRead {
  id               String   @id @default(cuid())
  announcementId Int
  userId           Int
  readAt          DateTime @default(now())
  // GDPR minimisation: read receipts purge after one academic cycle (~13 months) by default.
  expiresAt       DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
  @@index([expiresAt])
}

model WebPushSubscription {
  id        String   @id @default(cuid())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnnouncementComment {
  id             Int       @id @default(autoincrement())
  announcementId Int
  authorId       Int
  bodyMarkdown   String    @db.Text
  parentId       Int?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  announcement Announcement         @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent       AnnouncementComment? @relation("AnnouncementCommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies      AnnouncementComment[] @relation("AnnouncementCommentThread")

  @@index([announcementId])
  @@index([authorId])
}

model AnnouncementReaction {
  id             Int    @id @default(autoincrement())
  announcementId Int
  userId         Int
  emoji          String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
}

model AnnouncementAcknowledgement {
  announcementId Int
  userId         Int
  acknowledgedAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
}

/// TCPA / compliance audit for announcement SMS. `phoneNumber` stores masked digits only.
model SmsAuditLog {
  id             Int               @id @default(autoincrement())
  userId         Int
  announcementId Int
  phoneNumber    String
  status         SmsAuditLogStatus
  reason         String?           @db.VarChar(500)
  sentAt         DateTime          @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([announcementId, sentAt])
  @@index([sentAt])
}

model DiscussionGroup {
  id         Int                 @id @default(autoincrement())
  scopeType  DiscussionScopeType
  scopeId    Int
  groupKey   String              @unique
  name       String
  status     DiscussionGroupStatus @default(ACTIVE)
  kind       DiscussionServerKind @default(SCOPE_GROUP)
  parentServerId Int?
  ownerId    Int?
  iconUrl    String?
  description String?            @db.Text
  defaultChannelId Int?         @unique
  e2eeEnabled Boolean              @default(true)
  e2eeCurrentKeyVersion Int        @default(1)
  e2eeRotationRequired Boolean     @default(false)
  createdAt  DateTime            @default(now())
  archivedAt DateTime?

  owner          User?                    @relation("DiscussionGroupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parentServer   DiscussionGroup?       @relation("ServerTree", fields: [parentServerId], references: [id], onDelete: SetNull)
  childServers   DiscussionGroup[]      @relation("ServerTree")
  defaultChannel DiscussionChannel?     @relation("DefaultChannel", fields: [defaultChannelId], references: [id], onDelete: SetNull)

  channelCategories DiscussionChannelCategory[]
  channels          DiscussionChannel[]       @relation("ChannelServer")
  roles             DiscussionRole[]

  memberships   DiscussionGroupMembership[]
  messages      DiscussionMessage[]
  notifications DiscussionNotification[]
  mutedUsers    DiscussionMuteSetting[]
  pinnedMessages DiscussionPinnedMessage[]
  attachments   DiscussionAttachment[]
  keyEnvelopes  DiscussionGroupKeyEnvelope[]
  auditLogs       DiscussionAuditLog[]
  /// Inverse of Club.serverId. Non-null only for USER_SERVER kinds backing a Club.
  club           Club?

  @@unique([scopeType, scopeId])
  @@index([status])
  @@index([scopeType, scopeId])
  @@index([kind])
  @@index([parentServerId])
}

model DiscussionChannelCategory {
  id        Int      @id @default(autoincrement())
  serverId  Int
  systemKey String
  name      String
  position  Int      @default(0)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  server   DiscussionGroup @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels DiscussionChannel[]

  @@unique([serverId, systemKey])
  @@index([serverId, position])
}

model DiscussionChannel {
  id             Int                   @id @default(autoincrement())
  serverId       Int
  categoryId     Int?
  name           String
  slug           String
  kind           DiscussionChannelKind @default(TEXT)
  position       Int                   @default(0)
  isDefault      Boolean               @default(false)
  isPrivate      Boolean               @default(false)
  topic          String?
  scopeType      DiscussionScopeType?
  scopeId        Int?
  legacyGroupId  Int?                  @unique
  archivedAt     DateTime?
  /// Minimum seconds between messages from the same user (0 = off). Moderators with MANAGE_MESSAGES bypass.
  slowModeSeconds Int                  @default(0)

  server           DiscussionGroup @relation("ChannelServer", fields: [serverId], references: [id], onDelete: Cascade)
  category         DiscussionChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages         DiscussionMessage[]
  overwrites       DiscussionPermissionOverwrite[]
  defaultForServer DiscussionGroup? @relation("DefaultChannel")
  auditLogs        DiscussionAuditLog[]

  @@unique([serverId, slug])
  @@index([serverId, position])
  @@index([serverId, archivedAt])
}

model DiscussionRole {
  id          Int      @id @default(autoincrement())
  serverId    Int
  systemKey   String
  name        String
  permissions BigInt   @default(0)
  position    Int      @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  server DiscussionGroup @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, systemKey])
  @@index([serverId, position])
}

model DiscussionPermissionOverwrite {
  id         Int                     @id @default(autoincrement())
  channelId  Int
  targetType DiscussionOverwriteTarget
  targetId   Int
  allow      BigInt                  @default(0)
  deny       BigInt                  @default(0)

  channel DiscussionChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, targetType, targetId])
  @@index([channelId])
}

/// Append-only moderation / settings history (A11).
model DiscussionAuditLog {
  id          Int      @id @default(autoincrement())
  serverId    Int
  channelId   Int?
  actorUserId Int
  action      String   @db.VarChar(64)
  targetType  String   @db.VarChar(32)
  targetId    Int
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  server  DiscussionGroup  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channel DiscussionChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  actor   User             @relation("DiscussionAuditLogActor", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt, id])
  @@index([channelId, createdAt, id])
}

/// User-created group chat (min 3 members). Messages use `DiscussionMessage.groupDmId` with `groupId` null.
model GroupDm {
  id          Int       @id @default(autoincrement())
  name        String?
  iconUrl     String?
  createdById Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  createdBy User            @relation("GroupDmCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   GroupDmMember[]
  messages  DiscussionMessage[]

  @@index([createdById])
  @@index([archivedAt])
}

model GroupDmMember {
  id        Int               @id @default(autoincrement())
  groupDmId Int
  userId    Int
  role      GroupDmMemberRole @default(MEMBER)
  canPost   Boolean           @default(true)
  joinedAt  DateTime          @default(now())
  leftAt    DateTime?

  groupDm GroupDm @relation(fields: [groupDmId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupDmId, userId])
  @@index([userId, leftAt])
}

model DiscussionGroupMembership {
  id          Int                    @id @default(autoincrement())
  groupId     Int
  userId      Int
  role        DiscussionMembershipRole
  canPost     Boolean                @default(false)
  canModerate Boolean                @default(false)
  isActive    Boolean                @default(true)
  joinedAt    DateTime               @default(now())
  leftAt      DateTime?
  /// Moderator-applied mute. When set and in the future, the member can't
  /// post / react / attach / start threads in any channel of this server.
  /// Null = not muted. Set by deans/admins via the moderation UI.
  mutedUntil  DateTime?

  group DiscussionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, userId])
  @@index([groupId, isActive])
  @@index([userId, leftAt])
}

model DiscussionMessage {
  id            Int                   @id @default(autoincrement())
  groupId       Int?
  channelId     Int?
  groupDmId     Int?
  senderId      Int?
  content       String?               @db.Text
  messageType   DiscussionMessageType @default(TEXT)
  createdAt     DateTime              @default(now())
  editedAt      DateTime?
  deletedAt     DateTime?
  parentMessageId Int?
  isAcceptedAnswer Boolean              @default(false)
  isAnonymous     Boolean              @default(false)
  keyVersion    Int?
  nonce         String?
  ciphertext    String?               @db.Text
  senderDeviceId String?

  group        DiscussionGroup?        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  channel      DiscussionChannel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  groupDm      GroupDm?                @relation(fields: [groupDmId], references: [id], onDelete: Cascade)
  sender       User?                     @relation("DiscussionMessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  parentMessage DiscussionMessage?       @relation("DiscussionMessageThread", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies      DiscussionMessage[]       @relation("DiscussionMessageThread")
  attachments  DiscussionAttachment[]
  readReceipts DiscussionReadReceipt[]
  reactions    DiscussionMessageReaction[]
  pinnedIn     DiscussionPinnedMessage[]
  notifications DiscussionNotification[]

  @@index([groupId, createdAt])
  @@index([groupId, keyVersion, createdAt])
  @@index([senderId])
  @@index([groupId, parentMessageId, createdAt])
  @@index([channelId, createdAt])
  @@index([groupDmId, createdAt])
  // Hot path: GET /channels/:id/messages filters by `parentMessageId IS NULL`
  // (main thread) or `parentMessageId = ROOT_ID` (thread expansion). The
  // existing [channelId, createdAt] index forced row-level filtering on
  // every chat open. This index covers both predicates directly.
  @@index([channelId, parentMessageId, createdAt])
}

model DiscussionAttachment {
  id         Int                      @id @default(autoincrement())
  messageId  Int?
  uploadedById Int
  groupId    Int?
  url        String
  fileType   DiscussionAttachmentType
  mimeType   String
  size       BigInt
  status     String                   @default("PENDING")
  createdAt  DateTime                 @default(now())
  storageKey String?
  keyVersion Int?
  nonce      String?
  ciphertextHash String?

  message    DiscussionMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  group      DiscussionGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([uploadedById, status])
  @@index([groupId, createdAt])
}

model DiscussionReadReceipt {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  readAt    DateTime @default(now())

  message DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, userId])
  @@index([userId, readAt])
}

model DiscussionNotification {
  id          Int                      @id @default(autoincrement())
  userId      Int
  groupId     Int?
  messageId   Int?
  type        DiscussionNotificationType @default(MESSAGE)
  payload     Json
  createdAt   DateTime                 @default(now())
  readAt      DateTime?
  deliveredAt DateTime?

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   DiscussionGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  message DiscussionMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([groupId, createdAt])
}

model DiscussionSession {
  id          Int      @id @default(autoincrement())
  userId      Int
  socketId    String   @unique
  serverId    String
  connectedAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  disconnectedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([serverId, connectedAt])
}

model DiscussionMuteSetting {
  id      Int      @id @default(autoincrement())
  userId  Int
  groupId Int
  until   DateTime?
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group DiscussionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

model DiscussionPinnedMessage {
  id          Int      @id @default(autoincrement())
  groupId     Int
  messageId   Int
  pinnedById  Int
  pinnedAt    DateTime @default(now())
  unpinnedAt  DateTime?

  group    DiscussionGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  message  DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User              @relation("DiscussionPinnedBy", fields: [pinnedById], references: [id], onDelete: Cascade)

  @@index([groupId, pinnedAt])
  @@index([messageId])
}

model DiscussionMessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  emoji     String
  createdAt DateTime @default(now())

  message DiscussionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model DiscussionDeviceKey {
  id          Int      @id @default(autoincrement())
  userId      Int
  deviceId    String
  publicKey   String   @db.Text
  algorithm   String   @default("X25519")
  fingerprint String
  createdAt   DateTime @default(now())
  revokedAt   DateTime?
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyEnvelopes DiscussionGroupKeyEnvelope[]

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
}

model DiscussionGroupKeyEnvelope {
  id          Int      @id @default(autoincrement())
  groupId     Int
  keyVersion  Int
  userId      Int
  deviceId    String
  encryptedKey String  @db.Text
  algorithm   String   @default("X25519_AES_GCM")
  nonce       String?
  createdAt   DateTime @default(now())

  group  DiscussionGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  device DiscussionDeviceKey @relation(fields: [userId, deviceId], references: [userId, deviceId], onDelete: Cascade)

  @@unique([groupId, keyVersion, userId, deviceId])
  @@index([groupId, keyVersion])
  @@index([userId, deviceId])
}

model ChatRoom {
  id                Int      @id @default(autoincrement())
  name              String
  facultyId         Int?
  batchId           Int?
  sectionId         Int?
  courseOfferingId  Int?
  isGroupChat       Boolean  @default(false)
  created_at        DateTime @default(now())

  messages          ChatMessage[]
  courseOffering    CourseOffering? @relation(fields: [courseOfferingId], references: [id])
}

model ChatMessage {
  id         Int       @id @default(autoincrement())
  roomId     Int
  senderId   Int
  content    String    @db.Text
  /// Lightweight "reply-to" pointer. NOT a true thread root — clients render
  /// the original message as quoted context above the reply. Null = top-level.
  replyToId  Int?
  /// Set when the sender edits the message. Null = unmodified since creation.
  editedAt   DateTime?
  created_at DateTime  @default(now())

  room        ChatRoom             @relation(fields: [roomId], references: [id])
  sender      User                 @relation(fields: [senderId], references: [id])
  replyTo     ChatMessage?         @relation("ChatMessageReply", fields: [replyToId], references: [id])
  replies     ChatMessage[]        @relation("ChatMessageReply")
  attachments ChatAttachment[]
  mentions    ChatMessageMention[]

  @@index([roomId, created_at])
  @@index([replyToId])
}

/// File attached to a ChatMessage. Stored locally under /uploads/chat and
/// served via the existing express.static mount.
model ChatAttachment {
  id         Int     @id @default(autoincrement())
  messageId  Int
  name       String
  url        String
  size       Int?
  mimeType   String?
  created_at DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// One row per (message, mentioned user). Used to render highlights and to
/// drive future notification rows.
model ChatMessageMention {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  created_at DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model CourseGroup {
  id               Int      @id @default(autoincrement())
  name             String
  courseOfferingId Int
  created_by_id    Int
  created_at       DateTime @default(now())

  courseOffering CourseOffering        @relation(fields: [courseOfferingId], references: [id])
  creator        User                  @relation(fields: [created_by_id], references: [id])
  members        GroupMember[]
  submissions    Submission[]
  extensions     SubmissionExtension[]
}

model GroupMember {
  id               Int             @id @default(autoincrement())
  groupId          Int
  memberId         Int
  courseOfferingId Int
  role             GroupMemberRole @default(MEMBER)
  joined_at        DateTime        @default(now())

  group          CourseGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member         User           @relation(fields: [memberId], references: [id])
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
  @@unique([memberId, courseOfferingId])
}

/// Where a CoursePost came from. MANUAL is a human post; the others are
/// auto-generated by the dispatcher service from system events. Renders as a
/// badge in the Feed so students can tell a "class starting" post from a
/// teacher announcement at a glance.
enum CoursePostSource {
  MANUAL
  SESSION
  ATTENDANCE
  DEAN
  REGISTRATION
}

/// Per-course "Feed" post. Scoped to a single CourseOffering — visible to its
/// teacher and the students enrolled in the offering's section. Lightweight by
/// design (no SMS / search index / multi-target fan-out): the global Announcement
/// system stays untouched.
model CoursePost {
  id               Int              @id @default(autoincrement())
  courseOfferingId Int
  authorId         Int
  source           CoursePostSource @default(MANUAL)
  /// Stable key for auto-posts so dispatcher hooks stay idempotent (e.g.
  /// "session:123:start" prevents duplicate cron posts). Null for MANUAL.
  sourceKey        String?
  title            String
  content          String           @db.Text
  isImportant      Boolean          @default(false)
  isPinned         Boolean          @default(false)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt

  courseOffering CourseOffering         @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  author         User                   @relation(fields: [authorId], references: [id])
  attachments    CoursePostAttachment[]
  reactions      CoursePostReaction[]
  replies        CoursePostReply[]

  @@unique([courseOfferingId, source, sourceKey])
  @@index([courseOfferingId, created_at])
  @@index([authorId])
}

/// One reaction per (post, user, emoji). Toggling re-adds or deletes a row;
/// the unique constraint keeps counts honest.
model CoursePostReaction {
  id         Int      @id @default(autoincrement())
  postId     Int
  userId     Int
  emoji      String   @db.VarChar(16)
  created_at DateTime @default(now())

  post CoursePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
}

/// One-level-deep thread replies to a CoursePost. No nested replies — anyone
/// trying to "reply to a reply" just adds another reply to the parent post.
model CoursePostReply {
  id         Int      @id @default(autoincrement())
  postId     Int
  authorId   Int
  content    String   @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  post   CoursePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id])

  @@index([postId, created_at])
  @@index([authorId])
}

model CoursePostAttachment {
  id        Int     @id @default(autoincrement())
  postId    Int
  name      String
  url       String
  size      Int?
  mimeType  String?

  post CoursePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

/// Tracks the last time a user opened a given course offering (for the
/// "last seen" column on the roster). One row per (user, offering).
model CourseOfferingAccess {
  id               Int      @id @default(autoincrement())
  userId           Int
  courseOfferingId Int
  lastSeenAt       DateTime @default(now()) @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([userId, courseOfferingId])
  @@index([courseOfferingId, lastSeenAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Clubs — user-created communities layered on top of DiscussionGroup
// (kind=USER_SERVER). A Club row tracks lifecycle (PENDING → APPROVED) and
// presentation (banner, theme, rules). When APPROVED, Club.serverId points
// to the DiscussionGroup that backs it; PENDING clubs have no server yet.
// ─────────────────────────────────────────────────────────────────────────────

model Club {
  id              Int             @id @default(autoincrement())
  /// Slug used in URLs and to derive `DiscussionGroup.groupKey = "club:" + slug`.
  slug            String          @unique
  name            String
  tagline         String?         @db.VarChar(160)
  description     String?         @db.Text
  rules           String?         @db.Text
  /// Optional banner (1600x900) and icon (256x256). Both stored under uploads/.
  bannerUrl       String?
  iconUrl         String?
  /// One of a curated OKLCH palette (validated client-side AND server-side).
  themeColor      String?         @db.VarChar(16)

  status          ClubStatus      @default(PENDING)
  joinPolicy      ClubJoinPolicy  @default(BY_REQUEST)
  scopeKind       ClubScopeKind   @default(FACULTY)
  /// Set only when scopeKind=FACULTY. Drives which dean approves it.
  facultyId       Int?

  /// Null for system-seeded default clubs ("Sports", "Music"…). Non-null for
  /// user- or dean-created clubs.
  ownerId         Int?
  /// Set to true for seed clubs, shows a verified badge in the UI.
  isOfficial      Boolean         @default(false)

  /// Denormalised count, refreshed in transactions on join/leave for sort.
  memberCountCache Int            @default(0)
  /// Drives "active in last 7 days" badges and the auto-archive cron.
  lastActivityAt  DateTime?

  /// Once APPROVED, Club.serverId points at the DiscussionGroup that backs it.
  /// Nullable for PENDING clubs which have no server yet.
  serverId        Int?            @unique

  createdAt       DateTime        @default(now())
  decidedAt       DateTime?
  decidedByUserId Int?

  owner       User?              @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  faculty     Faculty?           @relation(fields: [facultyId], references: [id])
  decidedBy   User?              @relation("ClubDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  server      DiscussionGroup?   @relation(fields: [serverId], references: [id], onDelete: SetNull)

  interests   ClubInterest[]
  requests    ClubJoinRequest[]
  invites     ClubInvite[]
  audits      ClubModerationAudit[]

  @@index([status])
  @@index([scopeKind, status])
  @@index([facultyId, status])
  @@index([ownerId, status])
  @@index([lastActivityAt])
}

/// Vocabulary of interest tags. Seeded with ~30 starter rows in prisma/seed.js.
model InterestTag {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  label      String
  /// Free-form category for grouping in the UI (e.g. "Academic", "Hobby").
  category   String?
  createdAt  DateTime @default(now())

  clubs      ClubInterest[]
  users      UserInterest[]
}

model ClubInterest {
  clubId  Int
  tagId   Int

  club    Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tag     InterestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clubId, tagId])
  @@index([tagId])
}

model UserInterest {
  userId  Int
  tagId   Int
  pickedAt DateTime @default(now())

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag     InterestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([tagId])
}

model ClubJoinRequest {
  id              Int                    @id @default(autoincrement())
  clubId          Int
  userId          Int
  status          ClubJoinRequestStatus  @default(PENDING)
  reason          String?                @db.VarChar(500)
  requestedAt     DateTime               @default(now())
  decidedAt       DateTime?
  decidedByUserId Int?
  decideReason    String?                @db.VarChar(500)

  club        Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User  @relation("ClubJoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy   User? @relation("ClubJoinDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([userId, status])
}

model ClubInvite {
  id              Int               @id @default(autoincrement())
  clubId          Int
  inviterUserId   Int
  /// Null for generic link invites; set for targeted direct invites.
  inviteeUserId   Int?
  /// Cross-server channel invite: when set, accepting creates a per-user
  /// DiscussionPermissionOverwrite on this channelId rather than a full
  /// DiscussionGroupMembership.
  channelId       Int?
  token           String            @unique
  status          ClubInviteStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?

  club        Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  inviter     User  @relation("ClubInviteInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee     User? @relation("ClubInviteInvitee", fields: [inviteeUserId], references: [id], onDelete: SetNull)

  @@index([clubId, status])
  @@index([inviterUserId])
  @@index([inviteeUserId, status])
}

model ClubModerationAudit {
  id            Int                   @id @default(autoincrement())
  clubId        Int
  actorUserId   Int?
  action        ClubModerationAction
  reason        String?               @db.VarChar(500)
  payload       Json?
  createdAt     DateTime              @default(now())

  club        Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  actor       User? @relation("ClubAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([clubId, createdAt])
  @@index([actorUserId])
}

/// Singleton policy row holding the quota knobs (row id=1).
/// Lets ops bump caps without a redeploy if a campaign needs more clubs.
model ClubQuotaPolicy {
  id                Int    @id @default(autoincrement())
  perUserActiveCap  Int    @default(2)
  perUserPendingCap Int    @default(1)
  updatedAt         DateTime @updatedAt
}
