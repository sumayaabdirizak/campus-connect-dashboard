{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "kill-port 4000 && nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "prisma:db:status": "prisma migrate status",
    "db:reset-seed": "prisma migrate reset --force",
    "db:migrate": "prisma migrate deploy",
    "db:sync-chat": "prisma migrate deploy && npm run discussions:setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run unit.test",
    "test:announcements:e2e": "node scripts/announcement-e2e.js",
    "test:announcements:security": "node scripts/announcement-security-tests.js",
    "discussions:backfill:dry-run": "node scripts/discussion-backfill.js --dry-run",
    "discussions:backfill:apply": "node scripts/discussion-backfill.js --apply",
    "discussions:backfill:memberships": "node scripts/discussion-backfill.js --apply --memberships-only",
    "discussions:hybrid:dry-run": "node scripts/discussion-hybrid-backfill.js --dry-run",
    "discussions:hybrid:apply": "node scripts/discussion-hybrid-backfill.js --apply",
    "discussions:setup": "node scripts/discussions-setup.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@google/genai": "^2.6.0",
    "@prisma/client": "^6.19.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "file-type": "^22.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "redis": "^5.12.1",
    "sanitize-html": "^2.17.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
