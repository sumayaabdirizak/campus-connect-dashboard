# ─── Backend — copy to backend/.env ─────────────────────────────────────────
# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campus_connect?schema=public"

# Symmetric secret for JWT access/refresh tokens (use a long random string in production)
JWT_SECRET="dev-only-change-me"

# HTTP port for Express + Socket.IO
PORT=4000

# ─── Frontend — copy to frontend/.env.local ───────────────────────────────
# Base URL for REST (include /api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional announcements tuning
# NEXT_PUBLIC_ANNOUNCEMENT_NEW_DAYS=7
# NEXT_PUBLIC_ANNOUNCEMENT_DIAGNOSTIC=true
