                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/lecturer-courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "lecturer-courses"
              ],
              "query": [
                {
                  "key": "lecturerId",
                  "value": "5",
                  "description": ""
                }
              ]
            }
          },
          "response": [],
          "description": "Courses assigned to a specific lecturer within the dean's allowed faculties. REQUIRED: lecturerId. OPTIONAL: semester, academicYear to filter by term."
        },
        {
          "name": "Course Students (REQUIRED: courseCode, batch)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/course-students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "course-students"
              ],
              "query": [
                {
                  "key": "courseCode",
                  "value": "ECO101",
                  "description": ""
                },
                {
                  "key": "batch",
                  "value": "23-BA-01",
                  "description": ""
                }
              ]
            }
          },
          "response": [],
          "description": "Students enrolled in a specific course (via batch assignment). REQUIRED: courseCode, batch. OPTIONAL: section, gender (Male|Female|M|F), limit, offset."
        }
      ]
    },
    {
      "name": "04 · Student · My Data",
      "description": "Reads scoped to the logged-in student. Requires a student X-Access-Token (folder 02 — run the Student login request first).",
      "item": [
        {
          "name": "Me — profile, standing, courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{studentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/students/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "students",
                "me"
              ]
            }
          },
          "response": [],
          "description": "The authenticated student's profile, academic standing, current term and that term's active courses."
        }
      ]
    },
    {
      "name": "05 · AIS Reads (partner-level)",
      "description": "Machine-to-machine reads for Campus Connect. Only the partner signature is required (no role token).",
      "item": [
        {
          "name": "Verify student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/students/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "students",
                "verify"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"<StudentID>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "description": "Verify a University ID and account status."
        },
        {
          "name": "Student info",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
