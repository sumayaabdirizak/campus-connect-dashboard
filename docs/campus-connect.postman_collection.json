        {
          "name": "Faculties",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/faculties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "faculties"
              ]
            }
          },
          "response": [],
          "description": "Faculties the dean may access, with department/batch/student counts."
        },
        {
          "name": "Departments of a faculty",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/departments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "departments"
              ],
              "query": [
                {
                  "key": "facultyId",
                  "value": "12",
                  "description": ""
                }
              ]
            }
          },
          "response": [],
          "description": "Active departments of faculty 12 (Economics) with counts."
        },
        {
          "name": "Active batches (REQUIRED: facultyId, departmentId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/batches",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "batches"
              ],
              "query": [
                {
                  "key": "facultyId",
                  "value": "12",
                  "description": ""
                },
                {
                  "key": "departmentId",
                  "value": "21",
                  "description": ""
                }
              ]
            }
          },
          "response": [],
          "description": "Batches with at least one enrolled student. REQUIRED parameters: facultyId, departmentId."
        },
        {
          "name": "Students (REQUIRED: facultyId, departmentId, batch, status, limit)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "students"
              ],
              "query": [
                {
                  "key": "facultyId",
                  "value": "12",
                  "description": ""
                },
                {
                  "key": "departmentId",
                  "value": "16",
                  "description": ""
                },
                {
                  "key": "batch",
                  "value": "ba10",
                  "description": ""
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": ""
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": ""
                }
              ]
            }
          },
          "response": [],
          "description": "Students within faculty 12. REQUIRED parameters: facultyId, departmentId, batch, status, limit. status = active | graduated | all. Optional: offset for pagination."
        },
        {
          "name": "Courses (REQUIRED: facultyId, batch | OPTIONAL: semester)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "courses"
              ],
              "query": [
                {
                  "key": "facultyId",
                  "value": "12",
                  "description": ""
                },
                {
                  "key": "batch",
                  "value": "bf03",
                  "description": ""
                },
                {
                  "key": "term",
                  "value": "current",
                  "description": ""
                }
              ]
            }
          },
          "response": [],
          "description": "Active courses offered in faculty 12 for a specific batch. REQUIRED parameters: facultyId, batch. OPTIONAL: semester (defaults to active term), departmentId. term = current (default) | year (both semesters) | all (every offering)."
        },
        {
          "name": "Lecturers (OPTIONAL: facultyId, departmentId)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{partnerAuth}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Access-Token",
                "value": "{{deanToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/dean/lecturers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "dean",
                "lecturers"
